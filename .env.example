# Application Environment
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tennis_cms
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tennis_cms

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_URL=redis://:redis123@localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# AWS Configuration (for production deployment)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret

# ECS Configuration
ECS_CLUSTER_PROD=tennis-cluster-prod
ECS_CLUSTER_STAGING=tennis-cluster-staging

# Email Service (SendGrid, AWS SES, etc.)
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@celadontennis.com

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook-url

# Google Analytics / Monitoring
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Feature Flags
FEATURE_AMBASSADOR_PROGRAM=true
FEATURE_TOURNAMENT_MANAGEMENT=true
FEATURE_SPONSOR_PORTAL=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3001,https://app.celadontennis.com

# Development Tools
DEBUG=tennis:*

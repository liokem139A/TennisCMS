{
  "name": "tennis-cms-backend",
  "version": "1.0.0",
  "description": "Celadon Tennis Digital Platform - Backend API",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "vitest run src/__tests__/smoke.test.ts",
    "migrate:dev": "node --loader tsx ./db/migrate.ts",
    "migrate:test": "DATABASE_URL=postgresql://test:test@localhost:5432/tennis_test node --loader tsx ./db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "seed:dev": "node --loader tsx ./db/seed.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "db:push": "node --loader tsx ./db/migrations/push.ts",
    "db:reset": "node --loader tsx ./db/migrations/reset.ts"
  },
  "keywords": [
    "tennis",
    "cms",
    "api",
    "tournament",
    "management"
  ],
  "author": "Celadon Tennis",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.0",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.0",
    "node-cron": "^3.0.2",
    "pg": "^8.11.2",
    "pino": "^8.16.2",
    "pino-http": "^8.5.1",
    "pino-pretty": "^10.2.3",
    "redis": "^4.6.10",
    "uuid": "^9.0.1",
    "ws": "^8.14.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.20",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.8.9",
    "@types/ws": "^8.5.8",
    "@types/pg": "^8.10.7",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "@vitest/coverage-v8": "^0.34.6",
    "@vitest/ui": "^0.34.6",
    "eslint": "^8.52.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "supertest": "^6.3.3",
    "tsx": "^4.1.0",
    "typescript": "^5.2.2",
    "vitest": "^0.34.6"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}

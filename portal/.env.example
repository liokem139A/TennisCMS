# Application
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_NAME=Celadon Ambassador Portal

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
NEXT_PUBLIC_JWT_EXPIRY=2592000000

# AWS Configuration
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
NEXT_PUBLIC_AWS_COGNITO_CLIENT_ID=your_cognito_client_id
NEXT_PUBLIC_AWS_COGNITO_USER_POOL_ID=your_user_pool_id

# Database (DynamoDB)
DYNAMODB_TABLE_USERS=ambassador-users
DYNAMODB_TABLE_METRICS=ambassador-metrics
DYNAMODB_TABLE_EVENTS=ambassador-events

# OAuth (Social Login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
APPLE_CLIENT_ID=your_apple_client_id
APPLE_CLIENT_SECRET=your_apple_client_secret

# Email Service
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@celadon-tennis.com

# Logging
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn

# Feature Flags
FEATURE_2FA=false
FEATURE_SOCIAL_LOGIN=false
FEATURE_ANALYTICS=true
